# Contelb Contabilidade: configuração do Apache (KingHost)
# Este arquivo fica na raiz da pasta www. O subdomínio wd.contelb.com.br mora em www/wd/,
# então tudo aqui foi escrito para valer SÓ para contelb.com.br e www.contelb.com.br.

# index.php continua aceito para não quebrar o wd e outras pastas antigas
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

# Marca as visitas ao site principal (usado pelos cabeçalhos lá embaixo)
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host ^(www\.)?contelb\.com\.br$ SITE_PRINCIPAL
</IfModule>

# Arquivos que nunca devem ser baixados
<FilesMatch "\.(env|sh|ps1|bat|toml|md|log|codigo)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Subdomínios (wd e outros) e o endereço técnico do servidor passam direto, sem nenhuma regra abaixo
  RewriteCond %{HTTP_HOST} !^(www\.)?contelb\.com\.br$ [NC]
  RewriteRule ^ - [L]

  # Pasta interna do blog: bloqueada
  RewriteRule ^_blog(/|$) - [F,L]

  # URLs do site antigo (.php) vão direto para as novas, com 301 para manter o SEO
  RewriteRule ^index\.php$ https://www.contelb.com.br/ [R=301,L]
  RewriteRule ^sobre-nos(\.php)?/?$ https://www.contelb.com.br/sobre/ [R=301,L]
  RewriteRule ^abrir-empresa(\.php)?/?$ https://www.contelb.com.br/abrir-empresa-brasilia/ [R=301,L]
  RewriteRule ^trocar-de-contador\.php$ https://www.contelb.com.br/trocar-de-contador/ [R=301,L]
  RewriteRule ^s-contabilidade(\.php)?/?$ https://www.contelb.com.br/servicos/contabilidade-completa/ [R=301,L]
  RewriteRule ^s-trabalhista(\.php)?/?$ https://www.contelb.com.br/servicos/obrigacoes-trabalhistas/ [R=301,L]
  RewriteRule ^s-assessoria(\.php)?/?$ https://www.contelb.com.br/servicos/assessoria-empresarial/ [R=301,L]
  RewriteRule ^s-meime(\.php)?/?$ https://www.contelb.com.br/servicos/migrar-mei-para-me/ [R=301,L]
  # A página antiga era sobre tributação para desenvolvedores; o site novo não tem uma igual, e esta é a mais próxima
  RewriteRule ^tributacao(\.php)?/?$ https://www.contelb.com.br/planejamento-tributario/ [R=301,L]
  RewriteRule ^servicos\.php$ https://www.contelb.com.br/servicos/ [R=301,L]
  RewriteRule ^blog/pagina/?$ https://www.contelb.com.br/blog/ [R=301,L]
  RewriteRule ^contato\.php$ https://www.contelb.com.br/contato/ [R=301,L]
  RewriteRule ^area-do-cliente/?$ https://contelbcontabilidade.app.questorpublico.com.br/Authorize/LogOn [R=302,L]

  # Endereço canônico: sempre HTTPS e com www (o filtro de domínio lá em cima garante que é o site principal).
  # Na KingHost o cache (Varnish) fica na frente: o HTTPS chega avisado pelo cabeçalho X-Forwarded-Proto.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.contelb.com.br%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^contelb\.com\.br$ [NC]
  RewriteRule ^ https://www.contelb.com.br%{REQUEST_URI} [R=301,L]

  # /pagina/index.html vira /pagina/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Blog e arquivos enviados pelo painel: atendidos pelo PHP (blog.php)
  RewriteRule ^blog-media/ blog.php [L]
  RewriteRule ^blog(/.*)?$ blog.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff" env=SITE_PRINCIPAL
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=SITE_PRINCIPAL
  Header always set X-Frame-Options "SAMEORIGIN" env=SITE_PRINCIPAL
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()" env=SITE_PRINCIPAL
  <FilesMatch "\.(woff2|avif|webp|jpg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=SITE_PRINCIPAL
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000" env=SITE_PRINCIPAL
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600" env=SITE_PRINCIPAL
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
